# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=          # bcrypt hash — see README for how to generate

# JWT signing secret (32+ random bytes as hex)
AUTH_SECRET=                  # generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Booking form email (Resend — https://resend.com/api-keys)
RESEND_API_KEY=
BOOKING_TO_EMAIL=info@go-turkmenistan.com
# Must be on a domain verified in Resend; onboarding@resend.dev only delivers to the Resend account owner's email
BOOKING_FROM_EMAIL=Go Turkmenistan <booking@go-turkmenistan.com>
